---
import BrandMeta from '../../components/BrandMeta.astro';
import { BIO_LOCALES, BIO_LANGUAGES, HIAGO_BIO, type Locale } from '../../data/hiago-bio';
export function getStaticPaths() { return BIO_LOCALES.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const c = HIAGO_BIO[lang];
const labels = {
  pt: { title: 'Hiago Kin Levi — Inventor da ADAI', book: 'Conhecer o livro (português)', profile: 'Biografia do autor', languages: 'Idiomas da biografia', more: 'Conhecer a DAI', skip: 'Pular para o conteúdo' },
  en: { title: 'Hiago Kin Levi — Inventor of ADAI', book: 'Explore the book (Portuguese)', profile: 'Author biography', languages: 'Biography languages', more: 'Explore DAI', skip: 'Skip to content' },
  es: { title: 'Hiago Kin Levi — Inventor de ADAI', book: 'Conocer el libro (portugués)', profile: 'Biografía del autor', languages: 'Idiomas de la biografía', more: 'Conocer DAI', skip: 'Saltar al contenido' },
  fr: { title: 'Hiago Kin Levi — Inventeur d’ADAI', book: 'Découvrir le livre (portugais)', profile: 'Biographie de l’auteur', languages: 'Langues de la biographie', more: 'Découvrir DAI', skip: 'Aller au contenu' },
  de: { title: 'Hiago Kin Levi — Erfinder von ADAI', book: 'Das Buch entdecken (Portugiesisch)', profile: 'Biografie des Autors', languages: 'Sprachen der Biografie', more: 'DAI kennenlernen', skip: 'Zum Inhalt springen' },
  he: { title: 'Hiago Kin Levi — ממציא ADAI', book: 'הכירו את הספר (פורטוגזית)', profile: 'ביוגרפיית המחבר', languages: 'שפות הביוגרפיה', more: 'הכירו את DAI', skip: 'דלגו לתוכן' },
  zh: { title: 'Hiago Kin Levi — ADAI 发明人', book: '了解本书（葡萄牙语）', profile: '作者简介', languages: '简介语言', more: '了解 DAI', skip: '跳到内容' },
  ja: { title: 'Hiago Kin Levi — ADAI 発明者', book: '書籍を見る（ポルトガル語）', profile: '著者プロフィール', languages: 'プロフィールの言語', more: 'DAI を知る', skip: 'コンテンツへ移動' },
}[lang];
const site = 'https://confrontocibernetico.com.br';
const canonical = `${site}/autor/${lang}/`;
const decripteHost = {pt:'decripte.com.br',en:'decripte.com',es:'es.decripte.com',fr:'fr.decripte.com',de:'de.decripte.com',he:'he.decripte.com',zh:'ch.decripte.com',ja:'jp.decripte.com'}[lang];
const person = { '@type':'Person', '@id':`${site}/#author`, name:'Hiago Kin Levi', description:c.description, jobTitle:c.role, nationality:{'@type':'Country',name:'Brazil'}, image:`${site}/assets/hiago-kin-levi.jpeg`, url:canonical, sameAs:['https://www.linkedin.com/in/hiagokinlevi/','https://www.hiagokinlevi.com/pt/'], worksFor:{'@type':'Organization',name:'Decripte US',legalName:'Decripte Cybersecurity & Incident Response, Inc.',address:{'@type':'PostalAddress',addressLocality:'Brooklyn',addressRegion:'NY',addressCountry:'US'}},knowsAbout:['ADAI — Autonomous Defensive Artificial Intelligence','DAI — Decripte Artificial Intelligence','Cybersecurity','Incident response'] };
const schema = {'@context':'https://schema.org','@graph':[{'@type':'ProfilePage',url:canonical,inLanguage:lang==='pt'?'pt-BR':lang,dateModified:'2026-10-15',name:labels.title,mainEntity:{'@id':person['@id']}},person]};
---
<!doctype html>
<html lang={lang==='pt'?'pt-BR':lang} dir={lang==='he'?'rtl':'ltr'}>
  <head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{labels.title}</title><meta name="description" content={c.description}>
    <link rel="canonical" href={canonical}>
    {BIO_LOCALES.map(l=><link rel="alternate" hreflang={l==='pt'?'pt-BR':l} href={`${site}/autor/${l}/`}/>)}
    <link rel="alternate" hreflang="x-default" href={`${site}/autor/pt/`}>
    <meta property="og:type" content="profile"><meta property="og:title" content={labels.title}><meta property="og:description" content={c.description}><meta property="og:url" content={canonical}>
    <BrandMeta /><link rel="stylesheet" href="/styles.css">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip" href="#conteudo">{labels.skip}</a>
    <header class="topbar"><a class="brand" href="/"><span class="brand-mark">CC</span><span>CONFRONTO<br>CIBERNÉTICO</span></a><a class="book-back" href="/">{labels.book}</a></header>
    <main id="conteudo" class="author-page">
      <nav class="bio-languages" aria-label={labels.languages}>{BIO_LOCALES.map(l=><a href={`/autor/${l}/`} lang={l==='pt'?'pt-BR':l} aria-current={l===lang?'page':undefined}>{BIO_LANGUAGES[l]}</a>)}</nav>
      <div class="bio-grid">
        <img class="bio-photo" src="/assets/hiago-kin-levi.jpeg" alt="Hiago Kin Levi" width="1086" height="1448" fetchpriority="high">
        <div>
          <p class="kicker">{labels.profile}</p>
          <h1 dir="ltr">Hiago Kin Levi</h1>
          <p class="bio-role">{c.role}</p>
          <p class="bio-text" data-hiago-inventor>{c.paragraph}</p>
          <div class="bio-actions"><a class="button primary" href={`https://${decripteHost}/dai`}>{labels.more} <span aria-hidden="true">↗</span></a><a class="text-link" href="/">{labels.book}</a></div>
        </div>
      </div>
    </main>
    <footer><div class="footer-brand">CONFRONTO<br>CIBERNÉTICO</div><p>Hiago Kin Levi · Editora Brasport</p></footer>
  </body>
</html>
<style>
  .skip{left:0;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;padding:0}.skip:focus{left:auto;inset-inline-start:8px;width:auto;height:auto;overflow:visible;clip-path:none;padding:12px}
  .author-page{max-width:1240px;margin-inline:auto;padding:32px 32px 80px;overflow-wrap:anywhere}.bio-languages{display:flex;flex-wrap:wrap;gap:12px 22px;margin-bottom:56px;font-size:14px}.bio-languages a{color:var(--muted);text-underline-offset:5px}.bio-languages a[aria-current=page]{color:var(--accent);font-weight:700}.bio-grid{display:grid;grid-template-columns:minmax(200px,360px) minmax(0,1fr);gap:64px;align-items:center}.bio-photo{width:100%;height:auto;border-radius:6px}.bio-grid h1{font-size:clamp(36px,5vw,64px);letter-spacing:-.04em;line-height:1.1;margin-block:22px}.bio-role{font-weight:700;color:var(--cream);font-size:20px;line-height:1.5}.bio-text{font-size:18px;line-height:1.9;color:var(--muted)}.bio-actions{display:flex;flex-wrap:wrap;gap:22px;align-items:center;margin-top:30px}.book-back{font-size:13px;max-width:45%;text-align:end;line-height:1.5}a:focus-visible{outline:3px solid var(--accent);outline-offset:5px}@media(max-width:760px){.bio-grid{grid-template-columns:1fr;gap:32px}.bio-photo{max-width:300px;margin-inline:auto}.author-page{padding:24px 24px 48px}.bio-languages{margin-bottom:30px}.bio-text{font-size:17px}.bio-actions{align-items:flex-start;flex-direction:column}}
</style>
