---
import { terms, termUrl } from '../../data/glossary';
import BrandMeta from '../../components/BrandMeta.astro';
import MobileNav from '../../components/MobileNav.astro';

const canonical = 'https://confrontocibernetico.com.br/glossario/';
const letters = [...new Set(terms.map((term) => term.name[0].toLocaleUpperCase('pt-BR')))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
const sorted = [...terms].sort((a, b) => a.name.localeCompare(b.name, 'pt-BR'));
const ld = { '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'Glossário de segurança cibernética', description: 'Termos técnicos relacionados ao livro Confronto Cibernético', url: canonical, inLanguage: 'pt-BR', about: { '@id': 'https://confrontocibernetico.com.br/#livro' }, hasDefinedTerm: terms.map((term) => ({ '@type': 'DefinedTerm', name: term.name, url: `https://confrontocibernetico.com.br${termUrl(term)}` })) };
---
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Glossário de cibersegurança | Confronto Cibernético</title><meta name="description" content="Busque 120 termos técnicos sobre APTs, resposta a incidentes, forense, inteligência e defesa. Uma página permanente para cada verbete."><link rel="canonical" href={canonical}><link rel="alternate" type="application/json" href="/glossario/catalogo.json"><meta property="og:type" content="website"><meta property="og:title" content="Glossário de segurança cibernética"><meta property="og:description" content="120 verbetes técnicos relacionados ao livro Confronto Cibernético."><meta property="og:url" content={canonical}><BrandMeta /><script type="application/ld+json" set:html={JSON.stringify(ld)} /><link rel="stylesheet" href="/styles.css"><script src="/site-effects.js" defer></script><script src="/glossary-filter.js" defer></script></head>
<body id="top"><a class="skip" href="#conteudo">Ir para o conteúdo</a><header class="topbar"><a class="brand" href="/"><span class="brand-mark">CC</span><span>CONFRONTO<br>CIBERNÉTICO</span></a><nav aria-label="Navegação principal"><a href="/">O livro</a><a href="/capitulos/">Capítulos</a><a href="/artigos/">Artigos</a><a href="/glossario/" aria-current="page">Glossário</a><a class="nav-cta" href="/#comprar">Onde comprar <span aria-hidden="true">↗</span></a></nav><MobileNav /></header>
<main id="conteudo" class="articles-index glossary-index"><div class="articles-intro"><p class="eyebrow">GLOSSÁRIO TÉCNICO</p><h1>Entenda os termos<br><em>do confronto cibernético.</em></h1><p>Encontre definições, contexto de uso e o capítulo relacionado no manuscrito original. Cada termo tem uma página permanente que pode ser compartilhada e encontrada diretamente na busca.</p><p class="article-count">{terms.length} termos técnicos · páginas individuais</p></div><div class="article-search"><label for="glossary-search">Buscar um termo, sigla ou tema</label><div><input id="glossary-search" type="search" placeholder="Ex.: APT, Black Team, forense" autocomplete="off"><button id="glossary-search-reset" type="button" hidden>Limpar</button></div><p id="glossary-result-count" role="status" aria-live="polite">{terms.length} verbetes encontrados</p></div><nav class="article-category-nav" aria-label="Índice alfabético">{letters.map((letter) => <a href={`#letra-${letter.toLocaleLowerCase('pt-BR')}`}>{letter}</a>)}</nav><p id="glossary-no-results" class="article-no-results" hidden>Nenhum termo encontrado. Tente outra palavra ou <a href="/artigos/">consulte os artigos</a>.</p>{letters.map((letter) => <section class="article-category glossary-letter" id={`letra-${letter.toLocaleLowerCase('pt-BR')}`}><div class="section-label"><span class="line"></span>LETRA {letter}</div><div class="glossary-grid">{sorted.filter((term) => term.name.toLocaleUpperCase('pt-BR').startsWith(letter)).map((term) => <a class="glossary-card" href={termUrl(term)} data-search={`${term.name} ${term.aliases.join(' ')} ${term.category} ${term.definition}`}><span>{term.category.toUpperCase()} · CAPÍTULO {term.chapterNumber}</span><h2>{term.name}</h2><p>{term.definition}</p><strong>Ver definição ↗</strong></a>)}</div></section>)}</main><a class="back-to-top" href="#top" aria-label="Voltar ao topo">↑</a><footer><div class="footer-brand">CONFRONTO<br>CIBERNÉTICO</div><p>Hiago Kin Levi · Editora Brasport</p><a href="/">Conhecer o livro ↑</a></footer></body></html>
