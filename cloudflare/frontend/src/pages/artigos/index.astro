---
import { articles, articleUrl } from '../../data/articles';
import BrandMeta from '../../components/BrandMeta.astro';
import MobileNav from '../../components/MobileNav.astro';
import ReadingPaths from '../../components/ReadingPaths.astro';
import { readingPaths } from '../../data/editorial';
const canonical = 'https://confrontocibernetico.com.br/artigos/';
const categories = [...new Set(articles.map((article) => article.category))];
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Artigos de cibersegurança | Confronto Cibernético</title>
  <meta name="description" content="104 artigos sobre resposta a incidentes, APTs, análise forense, inteligência, equipes de segurança e livros para estudar. Encontre seu tema.">
  <link rel="canonical" href={canonical}><meta property="og:type" content="website"><meta property="og:locale" content="pt_BR"><meta property="og:title" content="Artigos | Confronto Cibernético"><meta property="og:description" content="Guias temáticos sobre resposta a incidentes e segurança cibernética."><meta property="og:url" content={canonical}><BrandMeta />
  <link rel="stylesheet" href="/styles.css"><script src="/site-effects.js" defer></script><script src="/articles-filter.js" defer></script>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Artigos | Confronto Cibernético', url: canonical, inLanguage: 'pt-BR', about: { '@id': 'https://confrontocibernetico.com.br/#livro' }, mainEntity: { '@type': 'ItemList', itemListElement: readingPaths.map((path, index) => ({ '@type': 'ListItem', position: index + 1, name: path.title, url: `${canonical}#${path.id}`, item: { '@type': 'ItemList', name: path.title, itemListElement: path.slugs.map((slug, position) => ({ '@type': 'ListItem', position: position + 1, name: articles.find(article => article.slug === slug)?.keyword, url: `https://confrontocibernetico.com.br/artigos/${slug}/` })) } })) } })} />
</head>
<body id="top"><a class="skip" href="#conteudo">Ir para o conteúdo</a><header class="topbar"><a class="brand" href="/"><span class="brand-mark">CC</span><span>CONFRONTO<br>CIBERNÉTICO</span></a><nav aria-label="Navegação principal"><a href="/">O livro</a><a href="/capitulos/">Capítulos</a><a href="/artigos/" aria-current="page">Artigos</a><a href="/glossario/">Glossário</a><a class="nav-cta" href="/#comprar">Onde comprar <span aria-hidden="true">↗</span></a></nav><MobileNav /></header>
<main id="conteudo" class="articles-index"><div class="articles-intro"><p class="eyebrow">BIBLIOTECA TEMÁTICA</p><h1>Artigos sobre<br><em>confronto cibernético.</em></h1><p>Encontre uma resposta objetiva para sua pergunta e continue a leitura nos capítulos da obra. Os artigos organizam conceitos e decisões práticas; os trechos do livro estão identificados em páginas próprias.</p><p class="article-count">{articles.length} temas · 10 áreas de estudo</p></div>
  <div class="article-search"><label for="article-search">Buscar nos 104 artigos</label><div><input id="article-search" type="search" placeholder="Ex.: APT, ransomware, forense" autocomplete="off"><button id="article-search-reset" type="button" hidden>Limpar</button></div><p id="article-result-count" role="status" aria-live="polite">{articles.length} artigos encontrados</p></div>
  <ReadingPaths />
  <nav class="article-category-nav" aria-label="Áreas dos artigos">{categories.map((category) => <a href={`#${category.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-')}`}>{category}</a>)}</nav>
  <p id="article-no-results" class="article-no-results" hidden>Nenhum artigo encontrado. Tente outro termo ou <a href="/glossario/">consulte o glossário</a>.</p>
  {categories.map((category) => <section class="article-category" id={category.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-')}><div class="section-label"><span class="line"></span>{category.toUpperCase()}</div><div class="article-card-grid">{articles.filter((article) => article.category === category).map((article) => <a class="article-card" href={articleUrl(article)}><span>CAPÍTULO {article.chapterNumber} · GUIA</span><h2>{article.keyword}</h2><p>{article.answer}</p><strong>Ler artigo ↗</strong></a>)}</div></section>)}
</main><a class="back-to-top" href="#top" aria-label="Voltar ao topo">↑</a><footer><div class="footer-brand">CONFRONTO<br>CIBERNÉTICO</div><p>Hiago Kin Levi · Editora Brasport</p><a href="/">Conhecer o livro ↑</a></footer></body></html>
