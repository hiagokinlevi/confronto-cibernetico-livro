---
import ContactForm from '../components/ContactForm.astro';
import BrandMeta from '../components/BrandMeta.astro';
import AuthorIdentity from '../components/AuthorIdentity.astro';
import MobileNav from '../components/MobileNav.astro';
import { bookTitle, citationEditions, citationFormats, citationUrl } from '../data/book-citations';
---
<style>
  .citation-editions { display: grid; gap: 20px; margin: 28px 0; }
  .citation-edition { padding: clamp(18px, 4vw, 28px); border: 1px solid var(--line); background: var(--panel); }
  .citation-edition h3 { margin-bottom: 14px; font-size: 24px; }
  .citation-downloads { display: flex; flex-wrap: wrap; gap: 12px; }
  .citation-downloads a { border: 1px solid var(--line); max-width: 100%; line-height: 1.5; }
  @media (max-width: 600px) { .citation-downloads a { width: 100%; } }
</style>
